<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Screen-off playback: just_audio_background runs audio as a foreground
         service. No WAKE_LOCK and the CPU sleeps mid-track; no mediaPlayback
         type and Android 14+ refuses to start the service. -->
    <!-- The library. Without it, scoped storage blocks the folder and the app
         lists tracks that play silence. READ_MEDIA_AUDIO is the narrow Android
         13+ grant; READ_EXTERNAL_STORAGE covers 32 and below. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <!-- Covers are .jpg and READ_MEDIA_AUDIO grants audio only: without this
         every cover is a blank square. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <!-- The manifest and the spectrum .bin sit beside the audio and are not
         media, so READ_MEDIA_* cannot open them; without this the app falls
         back to the manifest bundled in the APK. Deliberate for a sideloaded
         app, not Play compliant. requestLegacyExternalStorage covers 10. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage"/>

    <!-- The media control IS a notification: without this the player has no
         shade or lock-screen presence. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Self-update: the downloaded APK is handed to the system installer, which
         still asks the user to confirm. F-Droid builds turn the check off. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Only the spectrum probe asks for this: a Visualizer on the output mix
         requires it. Playback never touches the microphone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Normal permission, no dialog; the Visualizer checks it before
         enabling. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!-- Release builds need this. Flutter ships INTERNET in the debug and
         profile manifests only, so a build without it silently loses weather,
         map tiles and POI lookups while hot reload keeps working. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Places: home, gym and uni are minutes apart, so only GPS accuracy
         separates them. Asked at first use; a refusal falls back to the IP
         lookup. No background variants. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <!-- youtubedl-android needs the bundled Python/ffmpeg EXTRACTED: that is
         useLegacyPackaging in build.gradle.kts, not this file. -->
    <application
        android:label="Sonarar"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true">

        <!-- MainActivity, not AudioServiceActivity directly: it extends it for
             the media session and lock-screen controls, and adds the permission
             channel the Dart side needs. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- The foreground service that owns the media session. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Hardware media buttons: headphone click, car controls, Bluetooth. -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>


        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
