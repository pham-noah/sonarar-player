<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen, drawn by Android before Flutter's engine has started.

     THIS IS WHAT REMOVED THE BLACK FLASH AT BOOT. It used to be `@android:color/white`, so every cold start
     showed a WHITE screen until Flutter's first frame — and since the app is a dark UI, that white flash was
     both ugly and unavoidable: no Dart code runs before it.

     Now it is the app's own background colour and nothing else. No mark, no wordmark: the app opens, it
     does not introduce itself. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
</layer-list>
